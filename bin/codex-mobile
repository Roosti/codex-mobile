#!/usr/bin/env bash

set -Eeuo pipefail

CODEX_MOBILE_VERSION="__CODEX_MOBILE_VERSION__"
if [[ "$CODEX_MOBILE_VERSION" == "__CODEX_MOBILE_VERSION__" ]]; then
  source_version_file="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/VERSION"
  if ! IFS= read -r CODEX_MOBILE_VERSION <"$source_version_file" ||
    [[ -z "$CODEX_MOBILE_VERSION" ]]; then
    printf 'codex-mobile: cannot read project version from %s\n' "$source_version_file" >&2
    exit 1
  fi
fi
if [[ ! "$CODEX_MOBILE_VERSION" =~ ^[0-9]+[.][0-9]+[.][0-9]+([-+][0-9A-Za-z.+-]+)?$ ]]; then
  printf 'codex-mobile: invalid project version: %s\n' "$CODEX_MOBILE_VERSION" >&2
  exit 1
fi
readonly CODEX_MOBILE_VERSION
readonly SESSION_PROJECT_OPTION="@codex-mobile-project"

session_name="${CODEX_MOBILE_SESSION:-codex-mobile}"
project_dir=""
project_dir_explicit=false
action="start"
attach_session=true
declare -a codex_args=()

usage() {
  cat <<'EOF'
Usage: codex-mobile [OPTIONS] [PROJECT_DIRECTORY] [-- CODEX_OPTIONS]

Start Codex in a persistent tmux session or reconnect to it.
Each session is bound to the project directory used when it was created.
Omit PROJECT_DIRECTORY to reconnect without comparing it to the current path.

Options:
  -s, --session NAME  Use a named tmux session (default: codex-mobile)
  -d, --detach        Start the session without attaching
  -l, --list          List Codex/tmux sessions
      --stop          Stop the selected session
      --version       Print the version
  -h, --help          Show this help

Examples:
  codex-mobile
  codex-mobile ~/code/my-app
  codex-mobile -s api ~/code/api
  codex-mobile ~/code/my-app -- --search

Detach without stopping Codex: Ctrl-b, then d
Inside tmux, the current client switches to the selected session.
EOF
}

die() {
  printf 'codex-mobile: %s\n' "$*" >&2
  exit 1
}

while (($# > 0)); do
  case "$1" in
    -s|--session)
      (($# >= 2)) || die "$1 needs a name"
      session_name="$2"
      shift 2
      ;;
    -d|--detach)
      attach_session=false
      shift
      ;;
    -l|--list)
      action="list"
      shift
      ;;
    --stop)
      action="stop"
      shift
      ;;
    --version)
      printf 'codex-mobile %s\n' "$CODEX_MOBILE_VERSION"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      codex_args=("$@")
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      [[ -z "$project_dir" ]] || die "only one project directory is allowed"
      project_dir="$1"
      project_dir_explicit=true
      shift
      ;;
  esac
done

[[ "$session_name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] ||
  die "session names may contain letters, numbers, underscores, and dashes"

command -v tmux >/dev/null 2>&1 || die "tmux is not installed"

session_exists() {
  local running_session
  while IFS= read -r running_session; do
    [[ "$running_session" == "$session_name" ]] && return 0
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
  return 1
}

case "$action" in
  list)
    if ! tmux list-sessions -F '#{session_name}  #{session_windows} window(s)  #{session_created_string}' 2>/dev/null; then
      printf 'No tmux sessions are running.\n'
    fi
    exit 0
    ;;
  stop)
    if session_exists; then
      tmux kill-session -t "$session_name"
      printf 'Stopped %s.\n' "$session_name"
    else
      printf 'No session named %s is running.\n' "$session_name"
    fi
    exit 0
    ;;
esac

codex_bin="$(command -v codex)" || die "Codex is not available on PATH"

if [[ "$project_dir_explicit" == true ]]; then
  requested_project_dir="$project_dir"
  if ! project_dir="$(realpath -e -- "$requested_project_dir" 2>/dev/null)" ||
    [[ ! -d "$project_dir" ]]; then
    die "project directory does not exist: $requested_project_dir"
  fi
fi

if session_exists; then
  if ! existing_project_dir="$(
    tmux show-options -v -t "$session_name" "$SESSION_PROJECT_OPTION" 2>/dev/null
  )" || [[ -z "$existing_project_dir" ]]; then
    cat >&2 <<EOF
codex-mobile: session "$session_name" has no project-directory metadata.

It may predate this safety check. Stop and recreate it, or use -s NAME to
create another session.
EOF
    exit 1
  fi

  if [[ "$project_dir_explicit" == true && "$existing_project_dir" != "$project_dir" ]]; then
    cat >&2 <<EOF
codex-mobile: session "$session_name" is already running in:
$existing_project_dir

Requested:
$project_dir

Use -s NAME to create another session.
EOF
    exit 1
  fi

  if ((${#codex_args[@]} > 0)); then
    printf 'Session %s already exists; extra Codex options were ignored.\n' "$session_name" >&2
  fi

  if [[ "$attach_session" == true ]]; then
    if [[ -n "${TMUX:-}" ]]; then
      exec tmux switch-client -t "$session_name"
    fi
    exec tmux attach-session -t "$session_name"
  fi

  printf '%s is already running. Attach with: tmux attach -t %s\n' "$session_name" "$session_name"
  exit 0
fi

if [[ "$project_dir_explicit" == false ]]; then
  requested_project_dir="$PWD"
  if ! project_dir="$(realpath -e -- "$requested_project_dir" 2>/dev/null)" ||
    [[ ! -d "$project_dir" ]]; then
    die "project directory does not exist: $requested_project_dir"
  fi
fi

tmux new-session -d -s "$session_name" -c "$project_dir" -- \
  "$codex_bin" -C "$project_dir" "${codex_args[@]}"
if ! tmux set-option -t "$session_name" "$SESSION_PROJECT_OPTION" "$project_dir"; then
  tmux kill-session -t "$session_name" 2>/dev/null || true
  die "could not record project metadata for session \"$session_name\""
fi

if [[ "$attach_session" == true ]]; then
  if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$session_name"
  fi
  exec tmux attach-session -t "$session_name"
fi

printf 'Started %s. Attach with: tmux attach -t %s\n' "$session_name" "$session_name"
