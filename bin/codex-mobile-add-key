#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

usage() {
  cat <<'EOF'
Usage: codex-mobile-add-key [--check] PUBLIC_KEY_FILE

Add one public SSH key to the current user's authorized_keys file.
Ed25519 keys are recommended. Never pass a private key here.

Options:
  --check  Validate the public key without changing authorized_keys
EOF
}

die() {
  printf 'codex-mobile-add-key: %s\n' "$*" >&2
  exit 1
}

check_only=false

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --check)
    check_only=true
    shift
    ;;
esac

(($# == 1)) || {
  usage >&2
  exit 1
}

readonly key_file="$1"
[[ -f "$key_file" ]] || die "not a file: $key_file"
command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen is not installed"

line_count="$(awk 'END { print NR }' "$key_file")"
[[ "$line_count" == 1 ]] || die "the file must contain exactly one public key"

key_type="$(awk 'NR == 1 { print $1 }' "$key_file")"
case "$key_type" in
  ssh-ed25519|sk-ssh-ed25519@openssh.com|ecdsa-sha2-*|sk-ecdsa-sha2-nistp256@openssh.com|ssh-rsa)
    ;;
  *)
    die "unsupported or invalid public key type: ${key_type:-empty}"
    ;;
esac

ssh-keygen -l -f "$key_file" >/dev/null 2>&1 || die "ssh-keygen rejected this public key"

if [[ "$check_only" == true ]]; then
  exit 0
fi

readonly ssh_dir="$HOME/.ssh"
readonly authorized_keys="$ssh_dir/authorized_keys"
key_blob="$(awk 'NR == 1 { print $2 }' "$key_file")"

mkdir -p -- "$ssh_dir"
chmod 700 -- "$ssh_dir"
touch -- "$authorized_keys"
chmod 600 -- "$authorized_keys"

if awk -v blob="$key_blob" '
  function supported_key_type(value) {
    return value == "ssh-ed25519" ||
      value == "ssh-rsa" ||
      value ~ /^ecdsa-sha2-/ ||
      value == "sk-ssh-ed25519@openssh.com" ||
      value == "sk-ecdsa-sha2-nistp256@openssh.com"
  }

  function tokenize(line, tokens,    ch, current, escaped, i, in_quotes, n, old) {
    for (old in tokens) {
      delete tokens[old]
    }

    for (i = 1; i <= length(line); i++) {
      ch = substr(line, i, 1)
      if (escaped) {
        current = current ch
        escaped = 0
      } else if (ch == "\\") {
        current = current ch
        escaped = 1
      } else if (ch == "\"") {
        current = current ch
        in_quotes = !in_quotes
      } else if ((ch == " " || ch == "\t") && !in_quotes) {
        if (current != "") {
          tokens[++n] = current
          current = ""
        }
      } else {
        current = current ch
      }
    }

    if (current != "") {
      tokens[++n] = current
    }
    return n
  }

  {
    line = $0
    sub(/^[[:space:]]*/, "", line)
    if (line == "" || substr(line, 1, 1) == "#") {
      next
    }

    token_count = tokenize(line, tokens)
    for (i = 1; i < token_count; i++) {
      if (supported_key_type(tokens[i])) {
        if (tokens[i + 1] == blob) {
          found = 1
          exit
        }
        break
      }
    }
  }

  END { exit !found }
' "$authorized_keys"; then
  printf 'Key is already authorized.\n'
  exit 0
fi

sed -n '1p' "$key_file" >>"$authorized_keys"
printf 'Added key: '
ssh-keygen -l -f "$key_file"
